[Unit]
Description=EmuPi OS frontend
After=local-fs.target systemd-user-sessions.service systemd-logind.service sound.target emupi-firstboot.service
Wants=emupi-firstboot.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=0

# The frontend owns tty1; Conflicts stops the stock getty when this starts.

[Service]
User=emupi
Group=emupi
PAMName=login
RuntimeDirectory=emupi
TTYPath=/dev/tty1
# tty-force: plain 'tty' waits FOREVER (silently, before any ExecStartPre runs) if anything
# else still owns tty1. tty-force takes it over instead.
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
# (no TTYVTDisallocate: it blanks tty1 and hides error messages)
UtmpIdentifier=tty1
UtmpMode=user
ExecStartPre=+/opt/emupi/bin/emupi-log service "starting emupi.service"
ExecStartPre=-+/opt/emupi/bin/emupi-prestart
ExecStart=/opt/emupi/bin/emupi-session
ExecStopPost=+/opt/emupi/bin/emupi-log service "emupi.service stopped: result=${SERVICE_RESULT} code=${EXIT_CODE} status=${EXIT_STATUS}"
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
