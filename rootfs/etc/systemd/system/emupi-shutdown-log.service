[Unit]
Description=EmuPi OS shutdown logger (records why the system went down)
DefaultDependencies=no
After=local-fs.target boot-firmware.mount systemd-journald.service
RequiresMountsFor=/boot/firmware
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/emupi/bin/emupi-log boot "boot reached emupi-shutdown-log (no shutdown yet)"
ExecStop=/opt/emupi/bin/emupi-shutdown-log
TimeoutStopSec=20

[Install]
WantedBy=sysinit.target
